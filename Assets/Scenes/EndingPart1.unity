  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6129ed696382ed8429d8c10ee9c4cf1b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  dialoguePlayer: {fileID: 1063082570}
  enemy: {fileID: 1877019041}
  kids: {fileID: 118272808}
  combat: {fileID: 635510724}
  enemyLines:
  - 'Kilmor: Don''t move! Remember me, you monster?'
  - '!<NAME>!: Oh look who showed up! The disgusting rat from the underground!'
  - '!<NAME>!: I left empty-handed after I dealt with you, because you had absolutely
    nothing of value.'
  - '!<NAME>!: What do you want from me now?'
  - 'Kilmor: You know what I want. I''ve come for vengeance.'
  - 'Kilmor: I told you to expect the unexpected, and here I am!'
  - 'Kilmor: Now say farewell to your poor life, because it''s over!'
  postFightLines:
  - 'Kilmor: I... I lost...'
  - 'Kilmor: My poor children... I''m so sorry how I failed you...'
  - 'Kilmor: Why me?! Why did it happen to me?! What have I done to deserve this
    life?!'
  - 'Kilmor: Ehh... That''s it I suppose.'
  - 'Kilmor: You''ll burn in hell for what you''ve done.'
  friendsLines:
  - 'Kilmor: Hello there, !<NAME>!!'
  - '!<NAME>!: Kilmor, it''s you! What are you doing in here?!'
  - 'Kilmor: I''m here to help. I could smell you coming, so I knew that something
    massive is about to happen.'
  - 'Kilmor: You saved my children and I promised to help you in your mission.'
  - 'Kilmor: Huh?'
  player: {fileID: 650320557}
