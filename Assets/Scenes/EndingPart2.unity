  m_Name: 
  m_EditorClassIdentifier: '::'
  player: {fileID: 1178238032}
  dialoguePlayer: {fileID: 2058258601}
  magnus: {fileID: 751190706}
  combat: {fileID: 460468683}
  cameraShake: {fileID: 751190705}
  preFight:
  - '!<NAME>!: You should way more than scared of us right now!'
  - '!<NAME>!: We have the Excalibur! We have the power to destroy you!'
  - 'Magnus: Just having the blade means nothing if you don''t know how to use it!'
  - 'Magnus: Now die!'
  postFight:
  - 'Magnus: No! That is not possible! You cannot beat me!'
  - 'Ponter: !<NAME>!! He''s weak! Use the Excalibur!'
  - 'Ponter: Blow him up!'
  - '!<NAME>!: Explosion!'
  magnusExplosion: {fileID: 709888901}
  ponter: {fileID: 139592470}
  blackoutManager: {fileID: 1772730556}
