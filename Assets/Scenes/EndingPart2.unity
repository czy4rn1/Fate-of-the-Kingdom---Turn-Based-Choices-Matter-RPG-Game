--- !u!114 &185583208
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 185583207}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 087ac855faead894a8f48a02d08ae8e4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  deserter: {fileID: 1420180601}
  dialoguePlayer: {fileID: 2058258601}
  player: {fileID: 1178238032}
  ponter: {fileID: 139592470}
  combat: {fileID: 460468683}
  magnus: {fileID: 751190706}
  cameraShake: {fileID: 751190705}
  preFightNoDes:
  - '!<NAME>!: We found your soul Magnus. Same as your father''s body.'
  - '!<NAME>!: You''re going down for good!'
  - 'Ponter: Get ready to fight!'
  preFightDes:
  - 'Deserter: Remember me, demon?'
  - 'Magnus: Ahh, you... The human deserter. I was certain you were long dead.'
  - 'Deserter: Well, I''m not! And we have your soul! We found your father''s body!'
  - 'Deserter: I will have my revenge!'
  - '!<NAME>!: Get ready to fight!'
  postFightDes:
  - 'Deserter: We''ve got him on his knees! His heart is open!'
  - '!<NAME>!: Come on! Finish him!'
  - 'Deserter: Alright! Let''s exorcise this monstrosity!'
  desFarewell:
  - 'Deserter: Well, I suppose this is where we part our ways.'
  - 'Deserter: I''m happy I got the chance to meet you both.'
  - 'Deserter: We did a great thing today. I''m sure the world is grateful.'
  - '!<NAME>!: What are you going to do now?'
  - 'Deserter: I''m not really sure. Maybe I''ll keep travelling. Perhaps I''ll track
    down the other demons. I don''t know.'
  - 'Ponter: You could always stay in Volsen once we''re done rebuilding it.'
  - 'Deserter: Maybe I''ll do so. I better get going. Thank you again.'
  - 'Deserter: Farewell to you two!'
  - '!<NAME>!: So long, deserter.'
  - 'Deserter: Oh, my name is Viktor! Okay, bye!'
  exorcism:
  - Exorcizo te, immundissime spiritus! Ipse Venena Bibas!
  - Vade retro Satan! Nunquam suade mihi vana!
  - Ecce Crucem Domini! Fugite partes adversae! Vicit Leo de tribu Juda, Radix David!
    Alleluia!
  badChoice:
  - 'Magnus: Hahaha!'
  - 'Magnus: Hahaha!'
  - 'Ponter: Why are you laughing? We beat you!'
  - 'Magnus: You stupid troglodytes! You just destroyed the only thing that could
    stop me!'
  - 'Magnus: You just made me unstoppable!'
  - 'Magnus: And now both of you will burn!'
  - '!<NAME>!: No!'
  magnusThrone: {fileID: 953414588}
  blackoutManager: {fileID: 1772730556}
  firePlayer: {fileID: 316494502}
  firePonter: {fileID: 850078446}
