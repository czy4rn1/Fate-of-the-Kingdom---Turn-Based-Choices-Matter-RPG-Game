--- !u!114 &751190705
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 751190703}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 679ad351a970735488289c03078002de, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  golems:
  - {fileID: 797617}
  - {fileID: 968459485}
  - {fileID: 0}
  venard: {fileID: 1673458072}
  blackoutManager: {fileID: 1772730556}
  player: {fileID: 1178238032}
  combat: {fileID: 460468683}
  dialoguePlayer: {fileID: 2058258601}
  golemsDialogue:
  - 'Magnus: Intruders in my own throne room...'
  - 'Magnus: Somehow you''ve managed to get past my first battalion...'
  - 'Magnus: But that is of no matter right now.'
  - 'Magnus: Golems - take care of them.'
  - 'Dad Golem: Get ready to die, human!'
  - 'Kid Golem: What he said!'
  golemsLostGem:
  - 'Dad Golem: Oh look who decided to show up! That filthy human from the forest!'
  - 'Dad Golem: Remember us? We told you we would see each other again in the near
    future.'
  - 'Dad Golem: And that future has finally come!'
  venardBad:
  - 'Magnus: Fithy basic humans inside my own throne room...'
  - 'Magnus: You''ll regret coming in here!'
  - 'Magnus: Venard! Take care of the situation!'
  - '!<NAME>!: What?! Venard?! '
  - '!<NAME>!: Venard?! But... why?!'
  - 'Venard: Your ways disgust me.'
  - 'Venard: Your failed attempt at your mission ends right now.'
  - 'Venard: And you with it!'
  venardPostGolems:
  - 'Magnus: You''ve managed to beat my weakest line of defence. Slightly impressive.'
  - 'Magnus: Are you going to be as determined even if faced with your own kind?'
  - '!<NAME>!: What are you talking about?!'
  - 'Magnus: Venard! Show yourself right now!'
  - '!<NAME>!: Venard?! But... why?!'
  - 'Venard: Your ways disgust me.'
  - 'Venard: Your failed attempt at your mission ends right now.'
  - 'Venard: And you with it!'
  venardGood:
  - '???: Not so fast!'
  - '!<NAME>!: Venard! What are you doing in here?'
  - 'Venard: I''ll deal with the golems! You deal with Magnus!'
  - 'Venard: I believe in you, !<NAME>!!'
  - 'Venard: Now come here you big morons!'
  - 'Dad Golem: No! Not him! Run!'
  venardSacrifice:
  - '!<NAME>!: This is your end Magnus! Prepare to die!'
  - '???: Wait, !<NAME>!!'
  - '!<NAME>!: Venard! What are you doing?!'
  - 'Venard: It''s okay. I''ll deal with him myself. I''ve got an ace up my sleeve!'
  - 'Venard: You''ve done enough harm to our planet, Magnus!'
  - 'Venard: Prepare for an increase of temperature, you monster!'
  - 'Magnus: You''ve weakened me... But is that all you''ve got?'
  - 'Magnus: Hahaha!'
  - 'Magnus: How about I let you taste your own medicine?'
  - '!<NAME>!: Venard, no!'
  - '!<NAME>!: You''ll pay for this, Magnus!'
  cameraController: {fileID: 542177054}
  ponter: {fileID: 984826781}
  magnusExplosion: {fileID: 1675281455}
  venardExplosion: {fileID: 149661031}
  paths: {fileID: 715974059}
