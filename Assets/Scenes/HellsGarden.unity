  m_Script: {fileID: 11500000, guid: d484bcfc3af0371458ab47e14c34fc03, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  garen: {fileID: 312546088}
  garenShadow: {fileID: 766593804}
  dialoguePlayer: {fileID: 1975500651}
  player: {fileID: 1894224574}
  ponter: {fileID: 1672912442}
  garenIntro:
  - 'Garen: Alright, do you know what you''re looking for?'
  - '!<NAME>!: Yes. A demonic sword.'
  - 'Garen: Oh... Looks like you''re way deeper in it than me.'
  - 'Garen: I''ll just keep you company and look for some other stuff.'
  - 'Garen: However if I may suggest, before you came here, I found here a secret
    path and I know how to open it.'
  - 'Garen: But I''m slightly afraid it might lock us inside it once we''re in. But
    it might also not, so I think we should go there!'
  ponterIntro:
  - '!<NAME>!: Alright, we''re in.'
  - '!<NAME>!: Let''s start looking for the Excalibur.'
  - 'Ponter: Keep your guard up.'
  moveToCutscene: {fileID: 400482662}
  secretPath: {fileID: 353450684}
  secretPathObject: {fileID: 167931461}
  blackoutManager: {fileID: 368938798}
  cameraController: {fileID: 40152452}
