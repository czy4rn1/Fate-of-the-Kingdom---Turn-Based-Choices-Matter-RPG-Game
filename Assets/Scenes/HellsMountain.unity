--- !u!114 &1496207660
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1496207655}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8eac28c2e635c0c46a54c48dfd3860d3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  player: {fileID: 1163092226}
  dialoguePlayer: {fileID: 1018231269}
  blackoutManager: {fileID: 800797893}
  garen: {fileID: 374361243}
  garenShadow: {fileID: 1073626944}
  garenPos:
  - 39.62
  - 20.56
  combat: {fileID: 2104092239}
  commandEntry: 'Garen: Let''s work together!'
  combatLines:
  - '!<NAME>!: You pose a threat to me, so I have to deal with you.'
  - '!<NAME>!: I''ve come too far to let someone screw my mission up!'
  - '!<NAME>!: Get ready to fight!'
  scareLines:
  - '!<NAME>!: Do you want to know what happened to the last person that tried to
    play me and join me?'
  - '!<NAME>!: I believe he''s still counting his teeth on the ground. That is if
    he managed to crawl up to them after I broke both of his legs.'
  - 'Garen: Okay, okay, okay. No hard feelings, man. I''ll just squeeze through and
    leave this place. Are we good?'
  - '!<NAME>!: Start moving before I snap your neck.'
  - 'Garen: Yes! Of course! Sure! Please take this money. I don''t look for no trouble,
    man.'
  - 'Garen: Bye!'
  introLines:
  - 'Garen: Stay right there! Who are you and why are you here?'
  - '!<NAME>!: My name''s !<NAME>!. I''m here to investigate this mountain.'
  - 'Garen: You can see it too? I''ve noticed that the residents of the nearby town
    couldn''t, except that one kid.'
  - '!<NAME>!: Yeah, we''ve talked to him as well. That''s why we are here.'
  - 'Garen: Okay, look. I''m a treasure hunter. How about we join our forces and
    get in there together, huh?'
  reqStr: 50
